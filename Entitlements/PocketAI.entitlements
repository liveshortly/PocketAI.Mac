<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- MLX compiles Metal shaders at runtime (mlx/backend/metal/jit_kernels).
	     Hardened runtime forbids that without this, so without it the app
	     notarizes but dies the first time a model runs. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The Rust core ships as a static lib inside an xcframework; library
	     validation rejects loading code not signed by the same team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
