<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MAC-19 / D132: no App Sandbox. The app ships Developer ID +
	     notarized only, and Tools > LiveShortly runs the user's `live`
	     daemon, which needs ~/.liveshortly, tmux and the agents. Only
	     hardened-runtime keys remain. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- MLX compiles Metal shaders at runtime (mlx/backend/metal/jit_kernels).
	     Hardened runtime forbids that without this, so without it the app
	     notarizes but dies the first time a model runs. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The Rust core ships as a static lib inside an xcframework; library
	     validation rejects loading code not signed by the same team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
