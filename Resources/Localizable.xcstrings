    "Sessions started from the web or iPhone need tmux. Install it in Terminal: `brew install tmux`": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions started from the web or iPhone need tmux. Install it in Terminal: `brew install tmux`"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वेब या iPhone से शुरू किए गए सत्रों को tmux चाहिए। इसे टर्मिनल में इंस्टॉल करें: `brew install tmux`"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las sesiones iniciadas desde la web o el iPhone necesitan tmux. Instálalo en Terminal: `brew install tmux`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sessions lancées depuis le web ou l'iPhone nécessitent tmux. Installez-le dans Terminal : `brew install tmux`"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitzungen, die vom Web oder iPhone gestartet werden, brauchen tmux. Installiere es im Terminal: `brew install tmux`"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WebやiPhoneから開始するセッションにはtmuxが必要です。ターミナルでインストールしてください：`brew install tmux`"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从网页或 iPhone 启动的会话需要 tmux。请在“终端”中安装：`brew install tmux`"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessões iniciadas pela web ou pelo iPhone precisam do tmux. Instale no Terminal: `brew install tmux`"
          }
        }
      }
    },
