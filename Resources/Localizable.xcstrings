    "Every chat in this project starts with these instructions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Chat in diesem Projekt beginnt mit diesen Anweisungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every chat in this project starts with these instructions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los chats de este proyecto empiezan con estas instrucciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque conversation de ce projet commence par ces instructions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस प्रोजेक्ट का हर चैट इन निर्देशों से शुरू होता है।"
          }
        },
        "ja": {
          "stringUnit": {
