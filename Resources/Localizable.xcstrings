    "This model is built for 1–%lld steps. More is slower, not better.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Modell ist für 1–%lld Schritte ausgelegt. Mehr ist langsamer, nicht besser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model is built for 1–%lld steps. More is slower, not better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este modelo está diseñado para 1–%lld pasos. Más pasos son más lentos, no mejores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
