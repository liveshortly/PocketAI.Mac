    "Your iPhone syncs within a second while PocketAI is open on it, or as soon as it opens.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone syncs within a second while PocketAI is open on it, or as soon as it opens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब आपके iPhone पर PocketAI खुला हो तो वह एक सेकंड के भीतर सिंक होता है, या खुलते ही।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu iPhone se sincroniza en un segundo mientras PocketAI está abierto en él, o en cuanto lo abres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre iPhone se synchronise en moins d'une seconde tant que PocketAI y est ouvert, ou dès son ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein iPhone synchronisiert sich innerhalb einer Sekunde, solange PocketAI darauf geöffnet ist, oder sobald es geöffnet wird."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhoneでPocketAIを開いている間は1秒以内に、開いた時点で同期されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当 iPhone 上打开 PocketAI 时，它会在一秒内同步，或在打开时立即同步。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu iPhone sincroniza em até um segundo enquanto o PocketAI está aberto nele, ou assim que ele abrir."
          }
        }
      }
    },
