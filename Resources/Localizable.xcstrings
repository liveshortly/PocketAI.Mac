    "MLX runs through Apple's MLX; GGUF runs through llama.cpp. Both run on this Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX runs through Apple's MLX; GGUF runs through llama.cpp. Both run on this Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX, Apple के MLX से चलता है; GGUF, llama.cpp से चलता है। दोनों इसी Mac पर चलते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX funciona con MLX de Apple; GGUF funciona con llama.cpp. Ambos se ejecutan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX s'exécute via MLX d'Apple ; GGUF via llama.cpp. Les deux tournent sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX läuft über Apples MLX, GGUF über llama.cpp. Beide laufen auf diesem Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLXはAppleのMLX、GGUFはllama.cppで動作します。どちらもこのMac上で実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX 通过 Apple 的 MLX 运行；GGUF 通过 llama.cpp 运行。两者都在这台 Mac 上运行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX roda pelo MLX da Apple; GGUF roda pelo llama.cpp. Ambos rodam neste Mac."
          }
        }
      }
    },
