    "Tools off — the model answers from what it knows": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools off — the model answers from what it knows"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टूल्स बंद — मॉडल अपनी जानकारी के आधार पर जवाब देता है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herramientas desactivadas: el modelo responde con lo que sabe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outils désactivés : le modèle répond avec ce qu'il sait"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werkzeuge aus – das Modell antwortet mit seinem vorhandenen Wissen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ツール オフ — モデルは既知の内容で答えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工具已关闭 — 模型仅根据已有知识回答"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ferramentas desativadas: o modelo responde com o que sabe"
          }
        }
      }
    },
    "Tools on — the model can search the web and, if Settings allows, run code you approve": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools on — the model can search the web and, if Settings allows, run code you approve"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टूल्स चालू — मॉडल वेब पर खोज सकता है और, अगर सेटिंग्स अनुमति दें, तो आपके मंज़ूर किए कोड चला सकता है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Herramientas activadas: el modelo puede buscar en la web y, si Ajustes lo permite, ejecutar código que apruebes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Outils activés : le modèle peut chercher sur le web et, si les Réglages l'autorisent, exécuter du code que vous approuvez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werkzeuge an – das Modell kann im Web suchen und, wenn die Einstellungen es erlauben, von dir genehmigten Code ausführen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ツール オン — モデルはWeb検索でき、設定で許可されていれば、承認したコードを実行できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工具已开启 — 模型可以搜索网络，并在设置允许时运行你批准的代码"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ferramentas ativadas: o modelo pode pesquisar na web e, se os Ajustes permitirem, executar código que você aprovar"
          }
        }
      }
    },
    "Turn off Offline mode to get one.": {
