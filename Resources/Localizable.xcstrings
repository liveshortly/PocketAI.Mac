    "Point any OpenAI-compatible client at that URL. Requests never leave this Mac.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point any OpenAI-compatible client at that URL. Requests never leave this Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी भी OpenAI-संगत क्लाइंट को उस URL पर इंगित करें। अनुरोध कभी इस Mac से बाहर नहीं जाते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apunta cualquier cliente compatible con OpenAI a esa URL. Las solicitudes nunca salen de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pointez n'importe quel client compatible OpenAI vers cette URL. Les requêtes ne quittent jamais ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richte einen beliebigen OpenAI-kompatiblen Client auf diese URL. Anfragen verlassen diesen Mac nie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OpenAI互換のクライアントをこのURLに向けてください。リクエストがこのMacの外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将任何兼容 OpenAI 的客户端指向该 URL。请求绝不会离开这台 Mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aponte qualquer cliente compatível com OpenAI para essa URL. As solicitações nunca saem deste Mac."
          }
        }
      }
    },
    "Press ⌘N to start a chat, or ⌘K to jump to anything — a chat, a project, a live session.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
