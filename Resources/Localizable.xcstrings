            "value": "PocketAI läuft noch nicht. Öffne es einmal und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI isn't running yet. Open it once and try again."
          }
        },
