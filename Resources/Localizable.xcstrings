    "Directories come from the daemon's own registration — this app can never name a path the machine has not allowed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verzeichnisse stammen aus der Registrierung des Daemons selbst – diese App kann niemals einen Pfad angeben, den der Computer nicht erlaubt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directories come from the daemon's own registration — this app can never name a path the machine has not allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los directorios provienen del propio registro del daemon: esta app nunca puede indicar una ruta que el equipo no haya permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les répertoires proviennent de l’enregistrement du daemon lui-même — cette app ne peut jamais indiquer un chemin que la machine n’a pas autorisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डायरेक्ट्री डीमन के अपने रजिस्ट्रेशन से आती हैं — यह ऐप कभी ऐसा पाथ नहीं बता सकता जिसकी मशीन ने अनुमति न दी हो।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ディレクトリはデーモン自身の登録に基づきます。このアプリが、マシンが許可していないパスを指定することはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os diretórios vêm do próprio registro do daemon — este app nunca pode indicar um caminho que a máquina não tenha permitido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目录来自守护进程自身的注册——此应用永远无法指定本机未允许的路径。"
          }
        }
      }
    },
