    "The agent runs without asking before each tool call. Only for a directory you trust it in.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent runs without asking before each tool call. Only for a directory you trust it in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एजेंट हर टूल कॉल से पहले पूछे बिना चलता है। केवल उस निर्देशिका के लिए जिस पर आप भरोसा करते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El agente se ejecuta sin preguntar antes de cada llamada a herramienta. Solo para un directorio en el que confíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'agent s'exécute sans demander avant chaque appel d'outil. Uniquement pour un dossier de confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Agent läuft ohne Rückfrage vor jedem Werkzeugaufruf. Nur für ein Verzeichnis, dem du vertraust."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントはツール呼び出しのたびに確認せずに実行されます。信頼できるディレクトリでのみ使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理在每次调用工具前不再询问。仅用于您信任的目录。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O agente roda sem perguntar antes de cada chamada de ferramenta. Só para um diretório em que você confia."
          }
        }
      }
    },
    "The link only works for you until access is widened above.": {
