    "Replies stop mid-sentence, paired devices lose this Mac until you set Access again in Server, and models must reload.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies stop mid-sentence, paired devices lose this Mac until you set Access again in Server, and models must reload."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उत्तर वाक्य के बीच में रुक जाते हैं, पेयर किए गए डिवाइस इस Mac को खो देते हैं जब तक आप सर्वर में पहुँच फिर सेट नहीं करते, और मॉडल दोबारा लोड करने होंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las respuestas se cortan a mitad de frase, los dispositivos emparejados pierden este Mac hasta que vuelvas a definir el Acceso en Servidor, y los modelos deben recargarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les réponses s'arrêtent en plein milieu, les appareils associés perdent ce Mac tant que vous n'avez pas redéfini l'accès dans Serveur, et les modèles doivent être rechargés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antworten brechen mitten im Satz ab, gekoppelte Geräte verlieren diesen Mac, bis du den Zugriff unter „Server“ neu setzt, und Modelle müssen neu geladen werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "返信は文の途中で止まり、ペアリング済みデバイスは「サーバ」でアクセスを再設定するまでこのMacに接続できなくなり、モデルは再読み込みが必要になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回复会在句子中途停止，已配对设备将无法连接这台 Mac，直到您在“服务器”中重新设置访问权限，且模型需要重新加载。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As respostas param no meio da frase, os dispositivos pareados perdem este Mac até você definir o Acesso de novo em Servidor, e os modelos precisam ser recarregados."
          }
        }
      }
    },
