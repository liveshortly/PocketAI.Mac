          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "经你批准后，允许模型在这台 Mac 上运行代码"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que o modelo execute código neste Mac após sua aprovação"
          }
