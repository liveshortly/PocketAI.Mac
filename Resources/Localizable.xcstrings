          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AppleのオンデバイスモデルでmacOSに含まれています。ダウンロード不要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 的设备端模型，属于 macOS 的一部分。无需下载。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O modelo no dispositivo da Apple, parte do macOS. Sem download."
          }
        }
      }
    },
    "Apps using the current key stop working until you give them the new one. The new key is copied to the clipboard.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps using the current key stop working until you give them the new one. The new key is copied to the clipboard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा कुंजी इस्तेमाल करने वाले ऐप तब तक काम करना बंद कर देंगे जब तक आप उन्हें नई कुंजी न दें। नई कुंजी क्लिपबोर्ड पर कॉपी हो जाती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las apps que usan la clave actual dejan de funcionar hasta que les des la nueva. La nueva clave se copia al portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les apps qui utilisent la clé actuelle cessent de fonctionner tant que vous ne leur donnez pas la nouvelle. La nouvelle clé est copiée dans le presse-papiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apps mit dem aktuellen Schlüssel funktionieren nicht mehr, bis du ihnen den neuen gibst. Der neue Schlüssel wird in die Zwischenablage kopiert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在のキーを使っているアプリは、新しいキーを渡すまで動作しなくなります。新しいキーはクリップボードにコピーされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用当前密钥的应用在您提供新密钥之前将停止工作。新密钥已复制到剪贴板。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os apps que usam a chave atual param de funcionar até você dar a nova. A nova chave é copiada para a área de transferência."
          }
        }
      }
    },
