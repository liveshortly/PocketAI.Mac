    "Delete “%@”? Its documents are removed; its chats are kept.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? Its documents are removed; its chats are kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” को हटाएँ? इसके दस्तावेज़ हटा दिए जाएँगे; इसकी चैट रखी जाएँगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Eliminar “%@”? Se quitan sus documentos; se conservan sus chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer « %@ » ? Ses documents sont retirés ; ses chats sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ löschen? Die Dokumente werden entfernt, die Chats bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」を削除しますか？ドキュメントは削除され、チャットは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除“%@”？其文档将被移除，聊天会保留。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Excluir “%@”? Os documentos são removidos; os chats são mantidos."
          }
        }
      }
    },
    "Delete “%@”? This cannot be undone.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? This cannot be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” को हटाएँ? इसे वापस नहीं किया जा सकता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Eliminar “%@”? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimer « %@ » ? Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ löschen? Das kann nicht rückgängig gemacht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」を削除しますか？この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除“%@”？此操作无法撤销。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Excluir “%@”? Isso não pode ser desfeito."
          }
        }
      }
    },
