          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पेयरिंग QR कोड। इसे अपने iPhone पर PocketAI में सेटिंग्स, डिवाइस, Mac के साथ पेयर करें में जाकर स्कैन करें।"
          }
