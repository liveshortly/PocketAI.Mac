    "Different number, or no number on the iPhone? Deny. Someone else on this network may be in between.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different number, or no number on the iPhone? Deny. Someone else on this network may be in between."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone पर नंबर अलग है, या कोई नंबर नहीं दिख रहा? अस्वीकार करें। इस नेटवर्क पर कोई और बीच में हो सकता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Número distinto, o ninguno en el iPhone? Deniega. Alguien más en esta red podría estar en medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numéro différent, ou aucun numéro sur l'iPhone ? Refusez. Quelqu'un d'autre sur ce réseau s'est peut-être interposé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andere Zahl oder gar keine auf dem iPhone? Lehne ab. Möglicherweise hängt jemand anderes in diesem Netzwerk dazwischen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhoneの番号が違う、または表示されていない場合は拒否してください。このネットワーク上の誰かが間に入っている可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone 上的数字不同，或没有显示数字？请拒绝。此网络上可能有其他人在中间拦截。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Número diferente, ou nenhum número no iPhone? Negue. Outra pessoa nesta rede pode estar no meio."
          }
        }
      }
    },
    "Directories come from the daemon's own registration — this app can never name a path the machine has not allowed.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directories come from the daemon's own registration — this app can never name a path the machine has not allowed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "निर्देशिकाएँ डेमॉन के अपने पंजीकरण से आती हैं — यह ऐप कभी ऐसा पथ नहीं बता सकता जिसकी मशीन ने अनुमति नहीं दी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los directorios provienen del propio registro del daemon: esta app nunca puede nombrar una ruta que la máquina no haya permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les dossiers viennent de l'enregistrement du daemon lui-même : cette app ne peut jamais désigner un chemin que la machine n'a pas autorisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verzeichnisse stammen aus der eigenen Registrierung des Daemons – diese App kann nie einen Pfad nennen, den die Maschine nicht erlaubt hat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ディレクトリはデーモン自身の登録から取得されます。このアプリが、マシンが許可していないパスを指定することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目录来自守护进程自身的注册——此应用永远无法指定机器未允许的路径。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os diretórios vêm do próprio registro do daemon: este app nunca pode indicar um caminho que a máquina não permitiu."
          }
        }
      }
    },
