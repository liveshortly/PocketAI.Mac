    "Hide models too big or unsupported for this Mac. Searching always shows everything.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide models too big or unsupported for this Mac. Searching always shows everything."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस Mac के लिए बहुत बड़े या असमर्थित मॉडल छिपाएँ। खोज हमेशा सब कुछ दिखाती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oculta los modelos demasiado grandes o no compatibles con este Mac. La búsqueda siempre muestra todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masquer les modèles trop gros ou non pris en charge par ce Mac. La recherche affiche toujours tout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modelle ausblenden, die für diesen Mac zu groß oder nicht unterstützt sind. Die Suche zeigt immer alles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacには大きすぎる、または非対応のモデルを非表示にします。検索ではすべて表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隐藏对这台 Mac 来说过大或不受支持的模型。搜索时始终显示全部。"
