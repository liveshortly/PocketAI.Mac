        }
      }
    },
    "The local server didn't start, so there is nothing for a device to pair with. Open Local server and start it there to see why.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der lokale Server wurde nicht gestartet, daher kann sich kein Gerät koppeln. Öffne „Lokaler Server“ und starte ihn dort, um den Grund zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local server didn't start, so there is nothing for a device to pair with. Open Local server and start it there to see why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El servidor local no se inició, así que no hay nada con lo que emparejar un dispositivo. Abre Servidor local e inícialo ahí para ver por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le serveur local n'a pas démarré, il n'y a donc rien à quoi appairer un appareil. Ouvrez Serveur local et démarrez-le pour voir pourquoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लोकल सर्वर शुरू नहीं हुआ, इसलिए किसी डिवाइस के पेयर करने के लिए कुछ नहीं है। कारण देखने के लिए लोकल सर्वर खोलें और उसे वहाँ से शुरू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ローカルサーバが起動しなかったため、デバイスをペアリングする相手がありません。「ローカルサーバ」を開いてそこで起動すると、理由が分かります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O servidor local não iniciou, então não há nada para um dispositivo emparelhar. Abra Servidor local e inicie-o ali para ver o motivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本地服务器未启动，因此没有可供设备配对的对象。打开“本地服务器”并在那里启动，即可查看原因。"
          }
        }
      }
    },
    "The menu bar icon asks from any app.": {
      "localizations": {
        "de": {
          "stringUnit": {
