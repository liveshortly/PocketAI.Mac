            "state": "translated",
            "value": "Hide models whose licence doesn't allow commercial use."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उन मॉडलों को छिपाएँ जिनका लाइसेंस व्यावसायिक उपयोग की अनुमति नहीं देता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oculta los modelos cuya licencia no permite el uso comercial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masquer les modèles dont la licence n'autorise pas l'usage commercial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modelle ausblenden, deren Lizenz keine kommerzielle Nutzung erlaubt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "商用利用を許可していないライセンスのモデルを非表示にします。"
