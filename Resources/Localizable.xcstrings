    "Publishing lists this session on the public feed for anyone to find.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Veröffentlichen erscheint diese Sitzung im öffentlichen Feed und ist für alle auffindbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publishing lists this session on the public feed for anyone to find."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al publicar, esta sesión aparece en el feed público y cualquiera puede encontrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La publication fait apparaître cette session dans le flux public, où tout le monde peut la trouver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रकाशित करने पर यह सेशन सार्वजनिक फ़ीड में दिखता है, जहाँ कोई भी इसे खोज सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "公開すると、このセッションが公開フィードに表示され、誰でも見つけられるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
