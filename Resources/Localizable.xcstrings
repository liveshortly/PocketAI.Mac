          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modèle sur l'appareil d'Apple, intégré à macOS. Aucun téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
