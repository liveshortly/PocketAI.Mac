    "Loopback only (127.0.0.1) — nothing outside this Mac can connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur Loopback (127.0.0.1) – nichts außerhalb dieses Mac kann sich verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback only (127.0.0.1) — nothing outside this Mac can connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo loopback (127.0.0.1): nada fuera de este Mac puede conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boucle locale uniquement (127.0.0.1) — rien à l'extérieur de ce Mac ne peut se connecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल लूपबैक (127.0.0.1) — इस Mac के बाहर से कुछ भी कनेक्ट नहीं हो सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ループバックのみ（127.0.0.1）。この Mac の外からは接続できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apenas loopback (127.0.0.1) — nada fora deste Mac pode se conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅限回环地址 (127.0.0.1) — 此 Mac 之外的设备无法连接。"
          }
        }
      }
    },
    "MLX runs through Apple's MLX; GGUF runs through llama.cpp. Both run on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX läuft über Apples MLX, GGUF über llama.cpp. Beide laufen auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX runs through Apple's MLX; GGUF runs through llama.cpp. Both run on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX se ejecuta a través de MLX de Apple; GGUF, a través de llama.cpp. Ambos se ejecutan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX fonctionne via MLX d'Apple ; GGUF via llama.cpp. Les deux s'exécutent sur ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX, Apple के MLX के ज़रिए चलता है; GGUF, llama.cpp के ज़रिए चलता है। दोनों इसी Mac पर चलते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX は Apple の MLX で、GGUF は llama.cpp で動作します。どちらもこの Mac 上で実行されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O MLX é executado pelo MLX da Apple; o GGUF, pelo llama.cpp. Ambos são executados neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MLX 通过 Apple 的 MLX 运行，GGUF 通过 llama.cpp 运行。两者都在此 Mac 上运行。"
          }
        }
      }
    },
