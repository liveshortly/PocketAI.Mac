          }
        }
      },
      "shouldTranslate": false
    },
    "A machine appears here once `live daemon` is running on it and registered to your account. Start the daemon from the directory you want agents to work in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Computer erscheint hier, sobald `live daemon` darauf läuft und er mit deinem Account registriert ist. Starte den Daemon im Verzeichnis, in dem die Agents arbeiten sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine appears here once `live daemon` is running on it and registered to your account. Start the daemon from the directory you want agents to work in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un equipo aparece aquí cuando `live daemon` se está ejecutando en él y está registrado en tu cuenta. Inicia el daemon desde el directorio en el que quieres que trabajen los agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un ordinateur apparaît ici dès que `live daemon` y est en cours d’exécution et qu’il est enregistré sur votre compte. Lancez le daemon depuis le répertoire dans lequel vous voulez que les agents travaillent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई मशीन यहाँ तब दिखती है जब उस पर `live daemon` चल रहा हो और वह आपके खाते से रजिस्टर हो। डीमन को उस डायरेक्टरी से शुरू करें जिसमें आप एजेंट से काम करवाना चाहते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "`live daemon` が実行され、アカウントに登録されると、そのマシンがここに表示されます。エージェントに作業させたいディレクトリでデーモンを起動してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma máquina aparece aqui quando `live daemon` está em execução nela e registrada na sua conta. Inicie o daemon a partir do diretório em que você quer que os agentes trabalhem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当某台机器上运行 `live daemon` 并已注册到你的账户后，它就会显示在这里。请在你希望代理工作的目录中启动该守护进程。"
          }
        }
      }
    },
    "A model's badge in the library says which engine runs it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Badge eines Modells in der Bibliothek zeigt, welche Engine es ausführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model's badge in the library says which engine runs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La insignia de un modelo en la biblioteca indica qué motor lo ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le badge d’un modèle dans la bibliothèque indique quel moteur l’exécute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लाइब्रेरी में मॉडल का बैज बताता है कि उसे कौन-सा इंजन चलाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライブラリ内のモデルのバッジは、どのエンジンで実行されるかを示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O selo de um modelo na biblioteca indica qual mecanismo o executa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "资源库中模型的标记会显示运行它的引擎。"
          }
        }
      }
    },
