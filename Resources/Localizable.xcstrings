    "PocketAI's on-device engine couldn't start. Please restart the app; if it keeps happening, reinstall. (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die On-Device-Engine von PocketAI konnte nicht gestartet werden. Starte die App neu; wenn das Problem weiterhin auftritt, installiere sie neu. (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketAI's on-device engine couldn't start. Please restart the app; if it keeps happening, reinstall. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El motor en el dispositivo de PocketAI no pudo iniciarse. Reinicia la app; si sigue ocurriendo, vuelve a instalarla. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur sur l'appareil de PocketAI n'a pas pu démarrer. Relancez l'app ; si le problème persiste, réinstallez-la. (%@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI का ऑन-डिवाइस इंजन शुरू नहीं हो सका। कृपया ऐप को फिर से शुरू करें; अगर यह बार-बार हो, तो दोबारा इंस्टॉल करें। (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAIのオンデバイスエンジンを起動できませんでした。アプリを再起動してください。繰り返し発生する場合は再インストールしてください。（%@）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O motor no dispositivo do PocketAI não conseguiu iniciar. Reinicie o app; se continuar acontecendo, reinstale-o. (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PocketAI 的设备端引擎无法启动。请重新启动应用；如果问题持续出现，请重新安装。（%@）"
          }
        }
      }
    },
    "Point any OpenAI-compatible client at that URL. Requests never leave this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richte einen beliebigen OpenAI-kompatiblen Client auf diese URL. Anfragen verlassen diesen Mac nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point any OpenAI-compatible client at that URL. Requests never leave this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apunta cualquier cliente compatible con OpenAI a esa URL. Las solicitudes nunca salen de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pointez n'importe quel client compatible OpenAI vers cette URL. Les requêtes ne quittent jamais ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी भी OpenAI-संगत क्लाइंट को उस URL पर पॉइंट करें। अनुरोध इस Mac से बाहर नहीं जाते।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OpenAI互換のクライアントをそのURLに向けてください。リクエストがこのMacから外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aponte qualquer cliente compatível com OpenAI para essa URL. As solicitações nunca saem deste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将任何兼容 OpenAI 的客户端指向该 URL。请求绝不会离开这台 Mac。"
          }
        }
      }
    },
