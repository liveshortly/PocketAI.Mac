    "A machine appears here once `live daemon` is running on it and registered to your account. Start the daemon from the directory you want agents to work in.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine appears here once `live daemon` is running on it and registered to your account. Start the daemon from the directory you want agents to work in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी मशीन पर `live daemon` चलने और आपके खाते में पंजीकृत होने के बाद वह यहाँ दिखती है। डेमॉन को उस निर्देशिका से शुरू करें जिसमें आप एजेंटों से काम करवाना चाहते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una máquina aparece aquí cuando `live daemon` se está ejecutando en ella y está registrada en tu cuenta. Inicia el daemon desde el directorio en el que quieres que trabajen los agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une machine apparaît ici dès que `live daemon` y tourne et qu'elle est enregistrée sur votre compte. Lancez le daemon depuis le dossier dans lequel vous voulez que les agents travaillent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Maschine erscheint hier, sobald `live daemon` darauf läuft und in deinem Konto registriert ist. Starte den Daemon in dem Verzeichnis, in dem die Agenten arbeiten sollen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マシン上で `live daemon` が実行されアカウントに登録されると、ここに表示されます。エージェントに作業させたいディレクトリでデーモンを起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当机器上运行 `live daemon` 并注册到您的账号后，它会显示在这里。请在希望代理工作的目录中启动守护进程。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma máquina aparece aqui quando `live daemon` está rodando nela e registrada na sua conta. Inicie o daemon no diretório em que você quer que os agentes trabalhem."
          }
        }
      }
    },
    "A model's badge in the library says which engine runs it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model's badge in the library says which engine runs it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लाइब्रेरी में मॉडल का बैज बताता है कि उसे कौन-सा इंजन चलाता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La insignia de un modelo en la biblioteca indica qué motor lo ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le badge d'un modèle dans la bibliothèque indique quel moteur l'exécute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Abzeichen eines Modells in der Bibliothek zeigt, welche Engine es ausführt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライブラリのモデルのバッジは、どのエンジンで動作するかを示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "模型库中模型的徽标表示由哪个引擎运行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O selo de um modelo na biblioteca indica qual mecanismo o executa."
          }
        }
      }
    },
