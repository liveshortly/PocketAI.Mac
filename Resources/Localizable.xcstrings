          }
        }
      }
    },
    "The session was created, but the machine refused to start the agent: %@. It is in the sidebar if you still want to open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Sitzung wurde erstellt, aber der Rechner hat den Start des Agenten abgelehnt: %@. Sie ist in der Seitenleiste, falls du sie trotzdem öffnen willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session was created, but the machine refused to start the agent: %@. It is in the sidebar if you still want to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sesión se creó, pero la máquina rechazó iniciar el agente: %@. Está en la barra lateral si aún quieres abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La session a été créée, mais la machine a refusé de lancer l'agent : %@. Elle se trouve dans la barre latérale si vous voulez quand même l'ouvrir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सेशन बन गया, लेकिन मशीन ने एजेंट शुरू करने से इनकार कर दिया: %@। अगर आप फिर भी इसे खोलना चाहें, तो यह साइडबार में है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "セッションは作成されましたが、マシンがエージェントの起動を拒否しました: %@。開きたい場合は、サイドバーにあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sessão foi criada, mas a máquina recusou iniciar o agente: %@. Ela está na barra lateral se você ainda quiser abri-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "会话已创建，但该机器拒绝启动代理：%@。如果仍要打开，可在边栏中找到它。"
          }
        }
      }
    },
    "This Mac ran out of memory for that model. Try a smaller one, or unload other models first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Mac hat nicht genügend Speicher für dieses Modell. Probiere ein kleineres Modell oder entlade zuerst andere Modelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac ran out of memory for that model. Try a smaller one, or unload other models first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este Mac se quedó sin memoria para ese modelo. Prueba con uno más pequeño o libera antes otros modelos de la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce Mac n'a plus assez de mémoire pour ce modèle. Essayez un modèle plus petit ou libérez d'abord d'autres modèles de la mémoire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उस मॉडल के लिए इस Mac की मेमोरी कम पड़ गई। कोई छोटा मॉडल आज़माएँ, या पहले दूसरे मॉडल अनलोड करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacのメモリがそのモデルには足りませんでした。小さいモデルを試すか、先に他のモデルをアンロードしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este Mac ficou sem memória para esse modelo. Tente um menor ou libere outros modelos da memória primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这台 Mac 的内存不足以运行该模型。请尝试更小的模型，或先卸载其他模型。"
          }
        }
      }
    },
    "This code expires in a few minutes and works once.": {
      "localizations": {
        "de": {
          "stringUnit": {
