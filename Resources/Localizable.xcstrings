    "One licence covers %lld devices, this Mac included. Remove a device below to pair another.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One licence covers %lld devices, this Mac included. Remove a device below to pair another."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक लाइसेंस %lld डिवाइस के लिए है, इस Mac सहित। दूसरा जोड़ने के लिए नीचे से कोई डिवाइस हटाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una licencia cubre %lld dispositivos, incluido este Mac. Quita un dispositivo de abajo para emparejar otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une licence couvre %lld appareils, ce Mac compris. Retirez un appareil ci-dessous pour en associer un autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Lizenz gilt für %lld Geräte, diesen Mac eingeschlossen. Entferne unten ein Gerät, um ein weiteres zu koppeln."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1つのライセンスで、このMacを含む%lld台のデバイスを利用できます。別のデバイスをペアリングするには、下のデバイスを1台削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一个许可证涵盖 %lld 台设备（含这台 Mac）。请先移除下方的一台设备，再配对其他设备。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma licença cobre %lld dispositivos, incluindo este Mac. Remova um dispositivo abaixo para parear outro."
          }
        }
      }
    },
