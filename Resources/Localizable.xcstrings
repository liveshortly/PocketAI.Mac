    "Use this if the code expired, was used, or had too many wrong tries.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this if the code expired, was used, or had too many wrong tries."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर कोड की अवधि खत्म हो गई, इस्तेमाल हो चुका या बहुत ज़्यादा गलत कोशिशें हुईं तो इसका उपयोग करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Úsalo si el código caducó, ya se usó o tuvo demasiados intentos fallidos."
