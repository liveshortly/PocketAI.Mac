    "Get licence opens our website; your key is shown there and emailed to you.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get licence opens our website; your key is shown there and emailed to you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“लाइसेंस पाएँ” हमारी वेबसाइट खोलता है; आपकी कुंजी वहाँ दिखती है और ईमेल भी की जाती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Obtener licencia” abre nuestro sitio web; tu clave se muestra allí y te la enviamos por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Obtenir une licence » ouvre notre site ; votre clé s'y affiche et vous est envoyée par e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Lizenz holen“ öffnet unsere Website; dort wird dein Schlüssel angezeigt und per E-Mail geschickt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「ライセンスを入手」で当社のウェブサイトが開きます。キーはそこに表示され、メールでも届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“获取许可证”会打开我们的网站；密钥会显示在那里，并通过电子邮件发送给您。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Obter licença” abre nosso site; sua chave aparece lá e também é enviada por e-mail."
          }
        }
      }
    },
    "Activate licence for %@?": {
      "extractionState": "extracted_with_value",
