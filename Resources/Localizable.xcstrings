    "It's unpaired and must scan a new code to come back. The iPhone keeps its own chats. To pause it instead, use Disconnect.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's unpaired and must scan a new code to come back. The iPhone keeps its own chats. To pause it instead, use Disconnect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह अनपेयर हो जाता है और वापस आने के लिए नया कोड स्कैन करना होगा। iPhone अपनी चैट रखता है। इसके बजाय रोकने के लिए डिस्कनेक्ट का उपयोग करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se desempareja y debe escanear un código nuevo para volver. El iPhone conserva sus propios chats. Para pausarlo, usa Desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est dissocié et doit scanner un nouveau code pour revenir. L'iPhone garde ses propres discussions. Pour simplement le suspendre, utilisez Déconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wird entkoppelt und muss einen neuen Code scannen, um zurückzukehren. Das iPhone behält seine eigenen Chats. Zum Pausieren stattdessen „Trennen“ verwenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリングが解除され、戻るには新しいコードのスキャンが必要です。iPhoneのチャットはiPhoneに残ります。一時停止するには「切断」を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它将取消配对，需要扫描新代码才能返回。iPhone 会保留自己的聊天。如只想暂停，请使用“断开连接”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ele é desemparelhado e precisa escanear um novo código para voltar. O iPhone mantém as próprias conversas. Para apenas pausar, use Desconectar."
          }
        }
      }
    },
