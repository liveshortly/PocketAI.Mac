    "Agents started from the web or your phone can only read and write inside these folders.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents started from the web or your phone can only read and write inside these folders."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वेब या आपके फ़ोन से शुरू किए गए एजेंट केवल इन फ़ोल्डरों के भीतर पढ़-लिख सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los agentes iniciados desde la web o tu teléfono solo pueden leer y escribir dentro de estas carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les agents lancés depuis le web ou votre téléphone ne peuvent lire et écrire que dans ces dossiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenten, die vom Web oder deinem Telefon gestartet werden, dürfen nur in diesen Ordnern lesen und schreiben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Webまたはスマートフォンから開始したエージェントは、これらのフォルダ内でのみ読み書きできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从网页或手机启动的代理只能在这些文件夹内读写。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentes iniciados pela web ou pelo celular só podem ler e gravar dentro destas pastas."
          }
        }
      }
    },
