    "Reachable from your LAN, so a paired iPhone can use this Mac. macOS will ask for Local Network permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im lokalen Netzwerk erreichbar, damit ein gekoppeltes iPhone diesen Mac nutzen kann. macOS fragt nach der Berechtigung für das lokale Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachable from your LAN, so a paired iPhone can use this Mac. macOS will ask for Local Network permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accesible desde tu LAN, así un iPhone emparejado puede usar este Mac. macOS pedirá el permiso de Red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accessible depuis votre réseau local, pour qu’un iPhone jumelé puisse utiliser ce Mac. macOS demandera l’autorisation Réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके LAN से पहुँच योग्य, ताकि पेयर किया गया iPhone इस Mac का उपयोग कर सके। macOS स्थानीय नेटवर्क की अनुमति माँगेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "LAN から接続できるようになり、ペアリングした iPhone がこの Mac を利用できます。macOS がローカルネットワークの使用許可を求めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acessível pela sua rede local, para que um iPhone pareado possa usar este Mac. O macOS vai pedir permissão de Rede Local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可从你的局域网访问，这样配对的 iPhone 就能使用这台 Mac。macOS 会请求本地网络权限。"
          }
        }
      }
    },
