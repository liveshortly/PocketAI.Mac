          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此项目中的每个聊天都以这些指令开始。"
          }
        }
      }
    },
    "Every finished reply is read out. Stop it from the reply itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede fertige Antwort wird vorgelesen. Du kannst das Vorlesen direkt in der Antwort stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every finished reply is read out. Stop it from the reply itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada respuesta completada se lee en voz alta. Puedes detenerla desde la propia respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque réponse terminée est lue à voix haute. Vous pouvez l’arrêter depuis la réponse elle-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर पूरा हुआ जवाब पढ़कर सुनाया जाता है। इसे जवाब से ही रोका जा सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完了した返信はすべて読み上げられます。読み上げは返信から停止できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toda resposta concluída é lida em voz alta. Você pode parar na própria resposta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每条完成的回复都会朗读出来。可在回复本身中停止朗读。"
          }
        }
      }
    },
