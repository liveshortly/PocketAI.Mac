    "Blocks every outbound request, including model downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blockiert alle ausgehenden Anfragen, einschließlich Modell-Downloads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks every outbound request, including model downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloquea todas las solicitudes salientes, incluidas las descargas de modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloque toutes les requêtes sortantes, y compris les téléchargements de modèles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मॉडल डाउनलोड सहित हर आउटबाउंड अनुरोध को रोकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "モデルのダウンロードを含め、すべての送信リクエストをブロックします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueia todas as solicitações de saída, incluindo downloads de modelos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "阻止所有外发请求，包括模型下载。"
          }
        }
      }
    },
