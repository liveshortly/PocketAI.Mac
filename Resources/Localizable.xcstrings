            "value": "यह मॉडल 1–%lld स्टेप्स के लिए बना है। ज़्यादा स्टेप्स धीमे होते हैं, बेहतर नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このモデルは1–%lldステップ向けに作られています。増やしても遅くなるだけで、品質は上がりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
