          "stringUnit": {
            "state": "translated",
            "value": "Approve only if you are holding that device and started pairing on it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल तभी स्वीकृत करें जब वह डिवाइस आपके हाथ में हो और जोड़ना आपने उसी पर शुरू किया हो।"
          }
        },
        "es": {
