          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'icône de la barre des menus permet de poser une question depuis n'importe quelle app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
