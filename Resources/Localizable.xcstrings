      }
    },
    "Lets your paired iPhones run code they send, in a sandbox on this Mac. Applies to all paired iPhones.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets your paired iPhones run code they send, in a sandbox on this Mac. Applies to all paired iPhones."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके पेयर किए iPhone जो कोड भेजते हैं उसे इस Mac पर सैंडबॉक्स में चलाने देता है। सभी पेयर किए iPhone पर लागू होता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que tus iPhone emparejados ejecuten el código que envíen, en un entorno aislado de este Mac. Se aplica a todos los iPhone emparejados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à vos iPhone associés d'exécuter le code qu'ils envoient, dans un bac à sable sur ce Mac. S'applique à tous les iPhone associés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt deinen gekoppelten iPhones, gesendeten Code in einer Sandbox auf diesem Mac auszuführen. Gilt für alle gekoppelten iPhones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペアリング済みのiPhoneから送られたコードを、このMacのサンドボックスで実行できるようにします。ペアリング済みのすべてのiPhoneに適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许你已配对的 iPhone 发送代码，并在这台 Mac 的沙盒中运行。适用于所有已配对的 iPhone。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que seus iPhones pareados executem o código que enviarem, em um sandbox neste Mac. Vale para todos os iPhones pareados."
          }
        }
      }
    },
