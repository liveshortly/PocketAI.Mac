    "After paying, your key is shown on the thank-you page and emailed to you.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After paying, your key is shown on the thank-you page and emailed to you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भुगतान के बाद आपकी कुंजी धन्यवाद पेज पर दिखेगी और ईमेल से भेजी जाएगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tras pagar, tu clave aparece en la página de agradecimiento y se te envía por correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après le paiement, votre clé s'affiche sur la page de remerciement et vous est envoyée par e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach der Zahlung wird dein Schlüssel auf der Dankesseite angezeigt und dir per E-Mail geschickt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "お支払い後、キーはお礼のページに表示され、メールでも送られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "付款后，你的密钥会显示在感谢页面，并通过电子邮件发送给你。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois de pagar, sua chave aparece na página de agradecimento e é enviada por e-mail."
          }
        }
      }
    },
