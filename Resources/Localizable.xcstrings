    },
    "Lets the model run code on this Mac after you approve it": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the model run code on this Mac after you approve it"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी मंज़ूरी के बाद मॉडल को इस Mac पर कोड चलाने देता है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que el modelo ejecute código en este Mac tras tu aprobación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet au modèle d'exécuter du code sur ce Mac après votre approbation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
