    "This machine hasn't checked in recently. Starting a session may produce one with no agent attached.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Rechner hat sich zuletzt nicht gemeldet. Eine neu gestartete Sitzung hat möglicherweise keinen Agenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine hasn't checked in recently. Starting a session may produce one with no agent attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina no se ha comunicado recientemente. Si inicias una sesión, puede quedar sin ningún agente asociado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette machine ne s'est pas signalée récemment. Lancer une session risque d'en créer une sans agent associé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस मशीन ने हाल में चेक-इन नहीं किया है। सेशन शुरू करने पर ऐसा सेशन बन सकता है जिससे कोई एजेंट जुड़ा न हो।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマシンは最近チェックインしていません。セッションを開始しても、エージェントが接続されないことがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina não se reportou recentemente. Iniciar uma sessão pode gerar uma sem nenhum agente associado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这台机器最近没有签到。启动会话后，可能不会附带任何代理。"
          }
        }
      }
    },
    "This model can't read images. Install a vision model to attach one.": {
