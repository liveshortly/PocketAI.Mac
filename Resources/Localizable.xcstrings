    "No account, no cloud — your chats never leave this machine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Konto, keine Cloud — deine Chats verlassen dieses Gerät nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no cloud — your chats never leave this machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin cuenta, sin nube — tus chats nunca salen de este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun compte, aucun cloud — vos conversations ne quittent jamais cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई खाता नहीं, कोई क्लाउड नहीं — आपकी चैट इस डिवाइस से बाहर नहीं जातीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントなし、クラウドなし — チャットがこの端末の外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem conta, sem nuvem — suas conversas nunca saem deste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无账户，无云端——你的聊天绝不会离开这台设备。"
          }
        }
      }
    },
