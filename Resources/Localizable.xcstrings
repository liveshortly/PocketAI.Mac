    "Press ⌘N to start a chat, or ⌘K to jump to anything — a chat, a project, a live session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drücke ⌘N, um einen Chat zu starten, oder ⌘K, um zu allem zu springen — einem Chat, einem Projekt, einer Live-Session."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌘N to start a chat, or ⌘K to jump to anything — a chat, a project, a live session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pulsa ⌘N para iniciar un chat o ⌘K para ir a cualquier cosa — un chat, un proyecto, una sesión en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appuyez sur ⌘N pour démarrer une discussion, ou sur ⌘K pour accéder à n'importe quoi — une discussion, un projet, une session en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चैट शुरू करने के लिए ⌘N दबाएँ, या किसी भी चीज़ पर जाने के लिए ⌘K — कोई चैट, कोई प्रोजेक्ट, कोई लाइव सेशन।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Nでチャットを開始、⌘Kで任意の項目へ移動 — チャット、プロジェクト、ライブセッション。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pressione ⌘N para iniciar um chat ou ⌘K para ir a qualquer coisa — um chat, um projeto, uma sessão ao vivo."
