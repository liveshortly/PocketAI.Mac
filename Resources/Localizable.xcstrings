        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर कोड की अवधि खत्म हो गई, इस्तेमाल हो चुका या बहुत ज़्यादा गलत कोशिशें हुईं तो इसका उपयोग करें।"
