    "Remove this folder? Agents running now will stop while the daemon restarts.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this folder? Agents running now will stop while the daemon restarts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह फ़ोल्डर हटाएँ? डेमन के रीस्टार्ट होने तक अभी चल रहे एजेंट रुक जाएँगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Quitar esta carpeta? Los agentes en ejecución se detendrán mientras el daemon se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retirer ce dossier ? Les agents en cours s'arrêteront pendant le redémarrage du daemon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diesen Ordner entfernen? Laufende Agenten stoppen, während der Daemon neu startet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフォルダを削除しますか？デーモンの再起動中、実行中のエージェントは停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移除此文件夹？守护进程重启期间，正在运行的智能体会停止。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remover esta pasta? Os agentes em execução vão parar enquanto o daemon reinicia."
          }
        }
      }
    },
