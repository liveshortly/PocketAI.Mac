    "Pro lets paired iPhones and other devices on your network use this Mac's models. Everything on this Mac stays free.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro lets paired iPhones and other devices on your network use this Mac's models. Everything on this Mac stays free."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro से पेयर किए गए iPhone और आपके नेटवर्क के अन्य डिवाइस इस Mac के मॉडल इस्तेमाल कर सकते हैं। इस Mac पर सब कुछ मुफ़्त रहता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro permite que los iPhone emparejados y otros dispositivos de tu red usen los modelos de este Mac. Todo lo que hay en este Mac sigue siendo gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro permet aux iPhone associés et aux autres appareils de votre réseau d'utiliser les modèles de ce Mac. Tout ce qui tourne sur ce Mac reste gratuit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit Pro können gekoppelte iPhones und andere Geräte in deinem Netzwerk die Modelle dieses Macs nutzen. Alles auf diesem Mac bleibt kostenlos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proでは、ペアリング済みのiPhoneやネットワーク上の他のデバイスがこのMacのモデルを使えます。このMac上での利用はすべて無料のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro 允许已配对的 iPhone 和网络上的其他设备使用这台 Mac 的模型。这台 Mac 上的一切仍然免费。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Pro permite que iPhones pareados e outros dispositivos da sua rede usem os modelos deste Mac. Tudo neste Mac continua gratuito."
          }
        }
      }
    },
