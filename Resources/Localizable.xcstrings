        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cancela la generación, detiene el servidor local y descarga los modelos de la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annule la génération, arrête le serveur local et décharge les modèles."
