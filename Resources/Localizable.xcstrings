    "A self-hosted LiveShortly server. A running daemon restarts to connect there.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A self-hosted LiveShortly server. A running daemon restarts to connect there."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्व-होस्टेड LiveShortly सर्वर। चल रहा डेमॉन वहाँ जुड़ने के लिए फिर शुरू होता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un servidor LiveShortly autoalojado. Un daemon en ejecución se reinicia para conectarse allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un serveur LiveShortly auto-hébergé. Un daemon en cours d'exécution redémarre pour s'y connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein selbst gehosteter LiveShortly-Server. Ein laufender Daemon startet neu, um sich dort zu verbinden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "セルフホストのLiveShortlyサーバです。実行中のデーモンは再起動して接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自托管的 LiveShortly 服务器。正在运行的守护进程会重启以连接到那里。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um servidor LiveShortly auto-hospedado. Um daemon em execução reinicia para se conectar a ele."
          }
        }
      }
    },
